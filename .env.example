OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Used only if you want the client to read public Supabase metadata later.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Naver Developers Open API. Used for /keyword live search and DataLab trend enrichment.
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Optional. Use these if Search API and DataLab API are registered under different Naver apps.
NAVER_SEARCH_CLIENT_ID=your-naver-search-client-id
NAVER_SEARCH_CLIENT_SECRET=your-naver-search-client-secret
NAVER_DATALAB_CLIENT_ID=your-naver-datalab-client-id
NAVER_DATALAB_CLIENT_SECRET=your-naver-datalab-client-secret
